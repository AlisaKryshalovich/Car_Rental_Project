CREATE TABLE cars
(
    car_id          SERIAL PRIMARY KEY,
    brand_id        INT REFERENCES brands (brand_id),
    model_id        INT REFERENCES models (model_id),
    body_type_id    INT REFERENCES body_types (body_type_id),
    year            INT           NOT NULL,
    engine_volume   DECIMAL(3, 1) NOT NULL,
    transmission_id INT REFERENCES transmissions (transmission_id),
    engine_type_id  INT REFERENCES engine_types (engine_type_id),
    car_status_id   INT REFERENCES car_status (status_id)
);
